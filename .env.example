# Linux VPS: usually 1000:1000 (first non-root user).
# macOS local: usually 501:20.
# Check with: id -u && id -g
PUID=1000
PGID=1000

TZ=Asia/Ho_Chi_Minh

JELLYFIN_USERNAME=admin
JELLYFIN_PASSWORD=changeme

# Paths INSIDE containers (do not change unless you also change volume mounts).
# On host these map to: ./media/movie and ./media/show
MOVIE_PATH=/media/movie
SHOW_PATH=/media/show

# Get claim at https://plex.tv/claim (~4 minutes).
PLEX_CLAIM=
# Public VPS IP or domain so Plex clients can reach the server.
PLEX_ADVERTISE_HOST=127.0.0.1

NZBGET_USER=nzbget
NZBGET_PASS=changeme
NZBGET_NEWS_HOST=
NZBGET_NEWS_PORT=563
NZBGET_NEWS_USER=
NZBGET_NEWS_PASS=
NZBGET_NEWS_CONNECTIONS=8
NZBGET_ARTICLE_CACHE=256
NZBGET_WRITE_BUFFER=1024

NEWZNAB_NAME=Newznab
NEWZNAB_URL=
NEWZNAB_API=
